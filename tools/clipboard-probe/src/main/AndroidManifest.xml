  Test-only clipboard probe. This manifest intentionally declares no permission at all:
  the probe must never be able to access the network, external storage or clipboard content
  beyond the length of the current clip. Only timestamps / lengths / MIME flags are exposed
  through the read-only ProbeProvider.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="Clipboard Probe"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Clipboard Probe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Read-only telemetry endpoint, used by the :app instrumented tests and by "adb shell
          content query/call". It does not expose clipboard text by design, so it needs no
          permission; it is only installed on test devices/emulators.
        -->
        <provider
            android:name=".ProbeProvider"
            android:authorities="org.fcitx.fcitx5.android.probe.events"
            android:enabled="true"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>

</manifest>
